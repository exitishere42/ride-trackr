<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Transluzente Liquid Glass Basis (Wallpaper scheint durch) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#26FFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>

    <!-- 2. Glas-Lichtbrechung Gradient (Top-Left Highlight zu Bottom-Right) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#38FFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#2000E676"
                android:type="linear" />
            <corners android:radius="26dp" />
        </shape>
    </item>

    <!-- 3. Subtile dunkle Tönung für starken Textkontrast über hellen Wallpapern -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33000000" />
            <corners android:radius="26dp" />
        </shape>
    </item>

    <!-- 4. Kristalliner Glass-Border Stroke (Lichtkante) -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1.3dp"
                android:color="#59FFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</layer-list>
